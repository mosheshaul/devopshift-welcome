// Jenkins Pipeline for CI/CD Integration (Fixed + Extended)

pipeline {
  agent any

//   options {
//     timestamps()
//   }

  environment {
    // Change this to your Docker Hub repo (must exist or be creatable)
    IMAGE_NAME = 'mosheshaul/flask-aws-monitor'
    DOCKER_BUILDKIT = '1'
  }

  stages {

    stage('Parallel Checks') {
      parallel {
        stage('Linting') {
          steps {
            sh '''#!/usr/bin/env bash
              set -euo pipefail

              echo "== Python lint (flake8) =="
              python3 -m venv .venv
              . .venv/bin/activate
              python -m pip install --upgrade pip
              pip install flake8
              # Adjust paths as needed
              flake8 .

              echo "== Shell lint (shellcheck) =="
              # Lint all .sh files if any exist
              if ls **/*.sh >/dev/null 2>&1; then
                shellcheck **/*.sh
              else
                echo "No shell scripts found. Skipping shellcheck."
              fi

              echo "== Dockerfile lint (hadolint) =="
              if [ -f Dockerfile ]; then
                hadolint Dockerfile
              else
                echo "No Dockerfile found! Failing."
                exit 1
              fi
            '''
          }
        }

        stage('Security Scan') {
          steps {
            sh '''#!/usr/bin/env bash
              set -euo pipefail

              echo "== Python security scan (bandit) =="
              python3 -m venv .venv-sec
              . .venv-sec/bin/activate
              python -m pip install --upgrade pip
              pip install bandit
              # -r = recursive; adjust to your app folder if desired
              bandit -r . -x .venv,.venv-sec

              echo "== Trivy filesystem scan (deps/secrets/misconfig) =="
              # Scans repo contents (lockfiles, configs, etc.)
              trivy fs --no-progress --severity HIGH,CRITICAL --exit-code 1 .
            '''
          }
        }
      }
    }

    stage('Build Docker Image') {
      steps {
        sh '''#!/usr/bin/env bash
          set -euo pipefail

          echo "Building image..."
          docker build -t "${IMAGE_NAME}:${BUILD_NUMBER}" -t "${IMAGE_NAME}:latest" .
        '''
      }
    }

    stage('Container Security Scan (Trivy image)') {
      steps {
        sh '''#!/usr/bin/env bash
          set -euo pipefail

          echo "Scanning built Docker image..."
          trivy image --no-progress --severity HIGH,CRITICAL --exit-code 1 "${IMAGE_NAME}:${BUILD_NUMBER}"
        '''
      }
    }

    stage('Push to Docker Hub') {
      steps {
        withCredentials([usernamePassword(credentialsId: 'dockerhub-creds', usernameVariable: 'DH_USER', passwordVariable: 'DH_PASS')]) {
          sh '''#!/usr/bin/env bash
            set -euo pipefail

            echo "${DH_PASS}" | docker login -u "${DH_USER}" --password-stdin

            docker push "${IMAGE_NAME}:${BUILD_NUMBER}"
            docker push "${IMAGE_NAME}:latest"

            docker logout
          '''
        }
      }
    }
  }

  post {
    success {
      echo 'Pipeline completed successfully!'
    }
    failure {
      echo 'Pipeline failed! Check logs for details.'
    }
    always {
      // Clean up local images to avoid filling the Jenkins agent disk
      sh '''
        set +e
        docker image rm -f "${IMAGE_NAME}:${BUILD_NUMBER}" "${IMAGE_NAME}:latest" 2>/dev/null || true
      '''
    }
  }
}
