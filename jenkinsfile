// Jenkins Pipeline for CI/CD Integration (Fixed + Extended)

pipeline {
  agent any

//   options {
//     timestamps()
//   }

  environment {
    // Change this to your Docker Hub repo (must exist or be creatable)
    IMAGE_NAME = 'mosheshaul/flask-aws-monitor'
    DOCKER_BUILDKIT = '1'
  }

  stages {

    stage('Parallel Checks') {
        parallel {
            stage('Linting') {
                steps {
                    sh '''#!/usr/bin/env bash
                    set -euo pipefail
                    echo "== Python lint (flake8) =="
                    docker run --rm -v "$PWD:/work" -w /work/welcome python:3.12-slim bash -lc '
                    python -m pip install --no-cache-dir -U pip &&
                    pip install --no-cache-dir flake8 &&
                    flake8 .
                    '
                    '''
                    }
                }

    stage('Security Scan') {
        steps {
            sh '''#!/usr/bin/env bash
            set -euo pipefail
            echo "== Python security scan (bandit) =="
            docker run --rm -v "$PWD:/work" -w /work/welcome python:3.12-slim bash -lc '
            python -m pip install --no-cache-dir -U pip &&
            pip install --no-cache-dir bandit &&
            bandit -r .
            '
            echo "== Trivy filesystem scan (welcome/) =="
            docker run --rm \
            -v "$PWD:/work" \
            -w /work \
            aquasec/trivy:latest \
            fs --no-progress --severity HIGH,CRITICAL --exit-code 1 welcome
            '''
        }
    }

  }
}


    stage('Build Docker Image') {
      steps {
        sh '''#!/usr/bin/env bash
        set -euo pipefail
        echo "Building image from welcome/Dockerfile..."
        docker build -f welcome/Dockerfile-t "${IMAGE_NAME}:${BUILD_NUMBER}" -t "${IMAGE_NAME}:latest" welcome
        '''
      }
    }

    stage('Container Security Scan (Trivy image)') {
      steps {
        sh '''#!/usr/bin/env bash
        set -euo pipefail
        echo "Scanning built Docker image..."
        trivy image --no-progress --severity HIGH,CRITICAL --exit-code 1 "${IMAGE_NAME}:${BUILD_NUMBER}"
        '''
      }
    }

    stage('Push to Docker Hub') {
      steps {
        withCredentials([usernamePassword(credentialsId: 'dockerhub-creds', usernameVariable: 'DH_USER', passwordVariable: 'DH_PASS')]) {
          sh '''#!/usr/bin/env bash
            set -euo pipefail

            echo "${DH_PASS}" | docker login -u "${DH_USER}" --password-stdin

            docker push "${IMAGE_NAME}:${BUILD_NUMBER}"
            docker push "${IMAGE_NAME}:latest"

            docker logout
          '''
        }
      }
    }
  }

  post {
    success {
      echo 'Pipeline completed successfully!'
    }
    failure {
      echo 'Pipeline failed! Check logs for details.'
    }
    always {
      // Clean up local images to avoid filling the Jenkins agent disk
      sh '''
        set +e
        docker image rm -f "${IMAGE_NAME}:${BUILD_NUMBER}" "${IMAGE_NAME}:latest" 2>/dev/null || true
      '''
    }
  }
}
